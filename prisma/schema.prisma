generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String       @unique
  password        String       @default("password123")
  role            Role         @default(user)
  avatar          String?
  status          EntityStatus @default(Active)
  joined          DateTime     @default(now())
  savedProperties Json?
  listings        Listing[]    @relation("AgentListings")
  messages        Message[]    @relation("AgentMessages")
}

model Listing {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float
  location    String
  category    String
  type        ListingType
  bedrooms    Int?
  bathrooms   Float?
  sqft        Int
  status      ListingStatus @default(Active)
  images      Json
  createdAt   DateTime      @default(now())
  agentId     String        @db.ObjectId
  agent       User          @relation("AgentListings", fields: [agentId], references: [id])
  messages    Message[]

  @@index([agentId])
}

model Category {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String?
  status      EntityStatus @default(Active)
}

model Location {
  id     String       @id @default(auto()) @map("_id") @db.ObjectId
  city   String
  state  String
  status EntityStatus @default(Active)

  @@unique([city, state])
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId   String   @db.ObjectId
  senderName  String
  senderEmail String
  senderPhone String?
  message     String
  agentId     String   @db.ObjectId
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  agent       User     @relation("AgentMessages", fields: [agentId], references: [id])
  listing     Listing  @relation(fields: [listingId], references: [id])

  @@index([agentId])
  @@index([listingId])
}

enum Role {
  user
  developer
  agent
  admin
  superadmin
}

enum ListingType {
  Rent
  Buy
  Short_Let @map("Short Let")
}

enum ListingStatus {
  Active
  Pending
  Sold
}

enum EntityStatus {
  Active
  Inactive
}
